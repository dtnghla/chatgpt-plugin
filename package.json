{
  "name": "chatgpt-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Time Zone Planner: a ChatGPT/Codex plugin (Agent Plugins package) backed by an MCP server with an MCP Apps widget.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtnghla/chatgpt-plugin.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "npm run build:web && tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "validate:plugin": "tsx scripts/validate-plugin.ts",
    "validate:plugin:release": "tsx scripts/validate-plugin.ts --release",
    "plugin:set-url": "tsx scripts/set-server-url.ts",
    "inspect": "npx @modelcontextprotocol/inspector",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run validate:plugin"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/express": "2.0.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "express": "5.2.1",
    "temporal-polyfill": "1.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}

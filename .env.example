# Copy to .env and adjust. The server reads process environment variables only;
# it does not load .env files itself. Export them in your shell, or pass the file
# to Docker with `docker run --env-file .env ...`.

# TCP port the HTTP server listens on. Default: 3000
PORT=3000

# Interface to bind. Default: 127.0.0.1 (loopback only).
# Use 0.0.0.0 inside containers or on a public host. When HOST is not a loopback
# address, ALLOWED_HOSTS is required and the server refuses to start without it.
HOST=127.0.0.1

# Comma-separated list of hostnames accepted in the Host and Origin headers of
# /mcp requests (DNS-rebinding and CSRF protection). Hostnames only: no scheme,
# no port (any port is accepted). Loopback names are always allowed when HOST is
# a loopback address. Example: ALLOWED_HOSTS=mcp.example.com
# ALLOWED_HOSTS=

# Comma-separated hostnames the server may download uploaded project files from.
# Default: oaiusercontent.com,openai.com
# Downloads must be HTTPS on port 443 and must not resolve to a private,
# loopback or reserved address. Add your host's file domain when it differs.
# FILE_HOST_ALLOWLIST=oaiusercontent.com,openai.com

# Optional. When set, the server returns this value as text/plain at
# GET /.well-known/openai-apps-challenge for OpenAI domain verification.
# Paste the token shown in the OpenAI Platform; remove it afterwards if you wish.
# OPENAI_APPS_CHALLENGE_TOKEN=

# Optional HTTPS origin advertised to ChatGPT for the MCP Apps widget. Use the
# dedicated widget origin if OpenAI asks for one; http is accepted for loopback.
# WIDGET_DOMAIN=https://widget.example.com

# Where generated bundles are kept between tool calls.
#   memory (default) - in-process, lost on restart, 20 newest bundles
#   s3               - durable, requires ARTIFACT_BUCKET and AWS credentials
# The S3 backend uses the AWS SDK default credential chain. The plugin itself
# never calls AWS; this is only the storage for its own generated artifacts.
# ARTIFACT_STORE=memory
# ARTIFACT_BUCKET=my-artifact-bucket
# AWS_REGION=us-east-1

# Secret used to sign artifact download links. Set the same value on all
# replicas. When omitted, a random secret is generated at startup, which
# invalidates existing links on restart.
# ARTIFACT_SIGNING_SECRET=

# Public HTTPS origin used in download links, e.g. https://mcp.example.com
# Required when the server is behind a proxy whose public hostname differs.
# PUBLIC_BASE_URL=https://mcp.example.com

# How long generated bundles and download links remain valid, in seconds.
# Default: 900 (15 minutes). Range: 60-86400.
# ARTIFACT_TTL_SECONDS=900
